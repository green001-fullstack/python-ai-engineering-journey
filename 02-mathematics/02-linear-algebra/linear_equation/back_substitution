def back_substitution(matrix):
    n = len(matrix)
    solutions = [0] * n

    # Start at the last row and work backwards
    for i in range(n - 1, -1, -1):

        # Constant on the right-hand side
        constant = matrix[i][-1]

        # Contributions from variables already solved
        known_contributions = 0

        for j in range(i + 1, n):
            known_contributions += matrix[i][j] * solutions[j]

        # Pivot
        pivot = matrix[i][i]

        # Solve the current variable
        solutions[i] = (constant - known_contributions) / pivot

    return solutions


matrix = [
    [2, 3, 1, 10],
    [0, -0.5, 0.5, 1],
    [0, 0, 3, 9]
]

output = back_substitution(matrix)

print(output)